@baseURL = http://localhost:3000
@token = {{login.response.body.$.token}}
@tokenComum = {{loginComum.response.body.$.token}}


# 1. AUTENTICAÇÃO

### Login como admin
# @name login
POST {{baseURL}}/auth/login
Content-Type: application/json

{
  "email": "admin@ifrs.edu.br",
  "senha": "123456"
}

### Login como usuário
# @name loginComum
POST {{baseURL}}/auth/login
Content-Type: application/json

{
  "email": "usuario@ifrs.edu.br",
  "senha": "123456"
}

### Login com senha errada
POST {{baseURL}}/auth/login
Content-Type: application/json

{
  "email": "admin@ifrs.edu.br",
  "senha": "errada"
}

### Login com e-mail inexistente
POST {{baseURL}}/auth/login
Content-Type: application/json

{
  "email": "ninguem@ifrs.edu.br",
  "senha": "123456"
}

### Login sem senha
POST {{baseURL}}/auth/login
Content-Type: application/json

{
  "email": "admin@ifrs.edu.br"
}

### Dashboard com token
GET {{baseURL}}/dashboard
Authorization: Bearer {{token}}

### Dashboard sem token
GET {{baseURL}}/dashboard

### Dashboard com token inválido
GET {{baseURL}}/dashboard
Authorization: Bearer token.invalido.123


# 2. EVENTOS

### Listar eventos
GET {{baseURL}}/events

### Buscar evento por id
GET {{baseURL}}/events/2

### Buscar evento inexistente
GET {{baseURL}}/events/9999

### Criar evento como admin
# @name eventoCriado
POST {{baseURL}}/events
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "titulo": "Feira de Adoção de Animais",
  "descricao": "Parceria com a ONG local.",
  "localizacao": "Pátio Central",
  "data_evento": "2026-12-15 10:00:00",
  "max_voluntarios": 8
}

### Criar evento sem token
POST {{baseURL}}/events
Content-Type: application/json

{
  "titulo": "Evento sem login",
  "localizacao": "Sala 2",
  "data_evento": "2026-12-20 10:00:00",
  "max_voluntarios": 4
}

### Criar evento com token inválido
POST {{baseURL}}/events
Authorization: Bearer token.invalido.123
Content-Type: application/json

{
  "titulo": "Evento token inválido",
  "localizacao": "Sala 2",
  "data_evento": "2026-12-20 10:00:00",
  "max_voluntarios": 4
}

### Criar evento como usuário comum
POST {{baseURL}}/events
Authorization: Bearer {{tokenComum}}
Content-Type: application/json

{
  "titulo": "Evento do usuário comum",
  "localizacao": "Sala 2",
  "data_evento": "2026-12-20 10:00:00",
  "max_voluntarios": 4
}

### Criar evento sem título
POST {{baseURL}}/events
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "localizacao": "Pátio Central",
  "data_evento": "2026-12-15 10:00:00",
  "max_voluntarios": 8
}

### Criar evento com limite inválido
POST {{baseURL}}/events
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "titulo": "Evento teste",
  "localizacao": "Sala 1",
  "data_evento": "2026-12-15 10:00:00",
  "max_voluntarios": 0
}

### Atualizar evento
PUT {{baseURL}}/events/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "titulo": "Campanha de Doação de Sangue (atualizada)",
  "descricao": "Doação em parceria com o hemocentro local.",
  "localizacao": "Ginásio do Campus",
  "data_evento": "2026-11-10 09:00:00",
  "max_voluntarios": 5
}

### Atualizar evento inexistente
PUT {{baseURL}}/events/9999
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "titulo": "Qualquer",
  "localizacao": "Qualquer",
  "data_evento": "2026-12-01 10:00:00",
  "max_voluntarios": 2
}

### Excluir evento
DELETE {{baseURL}}/events/5
Authorization: Bearer {{token}}

### Excluir evento inexistente
DELETE {{baseURL}}/events/9999
Authorization: Bearer {{token}}


# 3. VOLUNTÁRIOS

### Listar voluntários
GET {{baseURL}}/volunteers
Authorization: Bearer {{token}}

### Buscar voluntário por id
GET {{baseURL}}/volunteers/1
Authorization: Bearer {{token}}

### Buscar voluntário inexistente
GET {{baseURL}}/volunteers/9999
Authorization: Bearer {{token}}

### Cadastrar voluntário
# @name voluntarioCriado
POST {{baseURL}}/volunteers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Fábio Nunes",
  "email": "fabio@example.com",
  "telefone": "54999990006"
}

### Cadastrar com e-mail inválido
POST {{baseURL}}/volunteers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Teste",
  "email": "email_invalido"
}

### Cadastrar sem nome
POST {{baseURL}}/volunteers
Content-Type: application/json
Authorization: Bearer {{token}}


{
  "email": "semnome@example.com"
}

### Cadastrar com e-mail duplicado
POST {{baseURL}}/volunteers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Outra Ana",
  "email": "ana@example.com"
}

### Atualizar voluntário
PUT {{baseURL}}/volunteers/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Bruno Lima Souza",
  "email": "bruno@example.com",
  "telefone": "54999990002"
}

### Atualizar com e-mail duplicado
PUT {{baseURL}}/volunteers/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Bruno Lima",
  "email": "ana@example.com"
}

### Atualizar voluntário inexistente
PUT {{baseURL}}/volunteers/9999
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Qualquer",
  "email": "qualquer@example.com"
}

### Excluir voluntário
DELETE {{baseURL}}/volunteers/6
Authorization: Bearer {{token}}

### Excluir voluntário inexistente
DELETE {{baseURL}}/volunteers/9999
Authorization: Bearer {{token}}


# 4. INSCRIÇÕES

### Restaurar evento 1
PUT {{baseURL}}/events/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "titulo": "Campanha de Doação de Sangue",
  "descricao": "Doação em parceria com o hemocentro local.",
  "localizacao": "Ginásio do Campus",
  "data_evento": "2026-11-10 09:00:00",
  "max_voluntarios": 3
}

### Listar inscritos do evento 1
GET {{baseURL}}/events/1/volunteers
Authorization: Bearer {{token}}


### Inscrever voluntário
POST {{baseURL}}/events/1/volunteers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "voluntario_id": 3
}

### Inscrever em evento lotado
POST {{baseURL}}/events/1/volunteers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "voluntario_id": 5
}

### Inscrever voluntário já inscrito
POST {{baseURL}}/events/1/volunteers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "voluntario_id": 1
}

### Inscrever voluntário inexistente
POST {{baseURL}}/events/1/volunteers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "voluntario_id": 9999
}

### Inscrever em evento inexistente
POST {{baseURL}}/events/9999/volunteers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "voluntario_id": 1
}

### Inscrever sem voluntario_id
POST {{baseURL}}/events/1/volunteers
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Reduzir limite abaixo do total de inscritos
PUT {{baseURL}}/events/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "titulo": "Campanha de Doação de Sangue",
  "descricao": "Doação em parceria com o hemocentro local.",
  "localizacao": "Ginásio do Campus",
  "data_evento": "2026-11-10 09:00:00",
  "max_voluntarios": 1
}

### Cancelar inscrição
DELETE {{baseURL}}/events/1/volunteers/3
Authorization: Bearer {{token}}

### Cancelar inscrição inexistente
DELETE {{baseURL}}/events/1/volunteers/3
Authorization: Bearer {{token}}